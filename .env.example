# Supabase (required for full functionality)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Site URL (set to production URL in Vercel dashboard)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Embedding admin (required for /api/intelligence/* endpoints)
EMBEDDING_ADMIN_SECRET=your-secure-admin-secret
ENABLE_EMBEDDING_WRITES=false

# Future lab only — not required for V1
# GEMINI_API_KEY=your-gemini-api-key
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_DIMENSIONS=1536
